{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/productores/[id]",
      "regex": "^/productores/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/productores/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/catalogos",
      "regex": "^/admin/catalogos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/catalogos(?:/)?$"
    },
    {
      "page": "/admin/dashboard",
      "regex": "^/admin/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/dashboard(?:/)?$"
    },
    {
      "page": "/admin/productores",
      "regex": "^/admin/productores(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/productores(?:/)?$"
    },
    {
      "page": "/admin/usuarios",
      "regex": "^/admin/usuarios(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/usuarios(?:/)?$"
    },
    {
      "page": "/ayuda",
      "regex": "^/ayuda(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ayuda(?:/)?$"
    },
    {
      "page": "/comunidades",
      "regex": "^/comunidades(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/comunidades(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/fenotipo",
      "regex": "^/fenotipo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fenotipo(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/mi-perfil",
      "regex": "^/mi\\-perfil(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mi\\-perfil(?:/)?$"
    },
    {
      "page": "/productores",
      "regex": "^/productores(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/productores(?:/)?$"
    },
    {
      "page": "/sin-acceso",
      "regex": "^/sin\\-acceso(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sin\\-acceso(?:/)?$"
    },
    {
      "page": "/sociocultural",
      "regex": "^/sociocultural(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sociocultural(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}